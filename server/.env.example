# StorySpark AI Backend Environment Configuration Template
# Copy this file to server/.env and add your private secrets.
# NEVER commit server/.env to Git!

PORT=5000

# Client origin allowed in production (e.g. https://your-storyspark-frontend.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API Key from Google AI Studio (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=

# Supported Gemini Model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Firebase Project ID (matches your Firebase project)
FIREBASE_PROJECT_ID=storyspark-ai-8adb5

# Optional: Path to Firebase Service Account JSON (if downloaded from Firebase Console)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
